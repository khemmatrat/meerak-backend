        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={ \"carrier_code\": $json.carrier_code, \"penalty\": 5, \"reason\": \"48h SLA breach\" }"
      },
      "name": "Penalize Carrier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [750, 300]
