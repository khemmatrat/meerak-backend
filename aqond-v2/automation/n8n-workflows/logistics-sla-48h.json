        "responseMode": "onReceived"
      },
      "name": "Webhook 3PL Pickup",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "amount": 48,
        "unit": "hours"
      },
      "name": "Wait 48 Hours",
