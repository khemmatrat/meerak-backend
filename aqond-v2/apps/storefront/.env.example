# Rider OS Dev Lab (local only — delete flag + dev-lab routes for production)
# NEXT_PUBLIC_RIDER_DEV_LAB=1

# Food OS — Sprint S4 customer confirm gate (set false to rollback)
FOOD_CUSTOMER_CONFIRM=true
FOOD_AUTO_CONFIRM_MINUTES=15

# Food OS — Sprint S1 packing proof gate (set false to rollback)
FOOD_PACKING_GATE=true

# Food OS — Sprint S3 pickup QR gate (set false for legacy skip)
FOOD_PICKUP_QR_REQUIRED=true
NEXT_PUBLIC_FOOD_PICKUP_QR_REQUIRED=true

STOREFRONT_INTERNAL_URL=http://127.0.0.1:3003

# Sprint 30 — Experience Engine / FTX rollout
NEXT_PUBLIC_EXPERIENCE_ENGINE=1
NEXT_PUBLIC_EXPERIENCE_FTX=1
NEXT_PUBLIC_JARVIS_PROACTIVE=1

# Sprint 31 — Language Intelligence
NEXT_PUBLIC_JARVIS_LANG_INTEL=1
JARVIS_LANG_INTEL=1

# Sprint 32 — Conversation Memory
NEXT_PUBLIC_JARVIS_MEMORY=1
JARVIS_MEMORY=1

# Sprint 33 — Regional Persona Engine
NEXT_PUBLIC_JARVIS_PERSONA=1
JARVIS_PERSONA=1

# Sprint 35 — Voice & Multilingual (hands-free Jarvis)
NEXT_PUBLIC_JARVIS_VOICE=1
JARVIS_VOICE=1

# Phase 1.1+ Guardian (observe + shadow)
AGK_OBSERVE=on
AGK_FIREWALL=shadow
AGK_MODE=shadow
GUARDIAN_API_URL=http://127.0.0.1:8200
AGK_AGENT_ID=jarvis-prod-01
