# AQOND Marketplace v2 — copy to infra/.env and rotate all secrets before production
# cp infra/.env.example infra/.env

# development | production — production enables fail-closed secret checks in all services
AQOND_ENV=development

# Postgres (shared instance, isolated databases)
POSTGRES_USER=admin_boss
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
POSTGRES_HOST=aqond-db
POSTGRES_PORT=5432

# Databases created by init-multiple-dbs.sh
POSTGRES_DB_KONG=kong
POSTGRES_DB_BAGISTO=bagisto
POSTGRES_DB_STRAPI=strapi
POSTGRES_DB_ODOO=odoo
POSTGRES_DB_N8N=n8n
POSTGRES_DB_ESCROW=escrow

# Kong (DB-less declarative mode in P1)
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_ADMIN_LISTEN=127.0.0.1:8001

# JWT for gateway-protected routes (generate with: openssl rand -hex 32)
KONG_JWT_SECRET=CHANGE_ME_jwt_secret
# Comma-separated browser origins for Kong CORS (run render-kong-config.ps1 after edit)
KONG_CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3003,http://127.0.0.1:3003,https://aqond.com,https://app.aqond.com

# Merchant-facing API keys (browser onboard/studio UIs send these in production)
CMS_API_KEY=CHANGE_ME_cms_api_key
LIVE_MERCHANT_API_KEY=CHANGE_ME_live_merchant_key

# LiveKit (keys must match live/livekit.yaml)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-min-32-chars-ok
# Browser WebSocket (host machine)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Internal Docker HTTP API for RoomService
LIVEKIT_HTTP_URL=http://livekit:7880

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key
N8N_HOST=automation.localhost

# Strapi
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=CHANGE_ME
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME
STRAPI_JWT_SECRET=CHANGE_ME

# Bagisto / marketplace
BAGISTO_WEBHOOK_SECRET=CHANGE_ME_bagisto_webhook
# Mirror on Publish (profile p2b-bagisto) — Docker internal URL, NOT localhost/Kong
BAGISTO_APP_URL=http://bagisto-bridge:8089
# P2b+ Bagisto Laravel admin (browser / Kong strip_path)
BAGISTO_ADMIN_URL=http://localhost:8099
# Optional — auto-generated on first bagisto-app boot if empty
BAGISTO_LARAVEL_APP_KEY=

# P2a MinIO (product images)
MINIO_ROOT_USER=aqond_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_min_16_chars
MINIO_BUCKET=aqond-products
MINIO_PUBLIC_URL=http://localhost:9000

# P2b MySQL (Bagisto mirror — profile p2b-bagisto)
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=bagisto
MYSQL_USER=bagisto
MYSQL_PASSWORD=CHANGE_ME_mysql_bagisto_password

# P6 SLA → escrow REFUND (n8n + ai-core judge)
P6_SLA_HOURS=48
# Set 1 for smoke/tests without Ollama (rules-only judge)
SLA_USE_RULES_ONLY=0

# Voice / P5 Live Closer (Hertz GPU path — see voice/server.py)
VOICE_MODEL=cpu-stub
# 1 = rules-only closer (no Ollama wait, good for smoke tests)
VOICE_USE_RULES_ONLY=0

# Notifications (lightweight dispatcher — replace with full Novu in prod)
NOTIFY_API_KEY=CHANGE_ME_notify_key

# Analytics (P7 CrewAI re-rank)
ANALYTICS_API_KEY=CHANGE_ME_analytics_key
# 1 = allow browser POST /events/ingest without API key
ANALYTICS_PUBLIC_INGEST=1
# 1 = rules-only re-rank (no Ollama wait)
CREW_USE_RULES_ONLY=0

# Escrow API (internal service)
ESCROW_API_KEY=CHANGE_ME_escrow_internal_key

# P8 Hermes AI Core (Ollama orchestration)
# Official Ollama tags: hermes3:3b (~2GB) | hermes3:8b (~4.7GB) — NOT nous-hermes3:8b
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_CHAT=hermes3:3b
OLLAMA_MODEL_VISION=moondream
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_TIMEOUT_MS=540000
AI_MAX_CONCURRENT=1
AI_CORE_API_KEY=CHANGE_ME_ai_core_key
# CMS → ai-core round-trip (vision + Hermes JSON on CPU; must exceed OLLAMA_TIMEOUT_MS)
AI_ONBOARD_TIMEOUT_MS=600000
# Lite profile (~4GB disk): hermes3:3b + moondream
# Standard profile (~9GB): hermes3:8b + llava:7b — set OLLAMA_MODEL_CHAT/VISION accordingly

# Tier billing (THB)
TIER_FREE_THRESHOLD_THB=25000
TIER_MAX_RENTAL_FEE_THB=5000

# Data root on E: (Docker bind mounts — forward slashes for compose)
AQOND_DATA_ROOT=E:/aqond-data

# Native Ollama on Windows (if installed outside Docker)
# Native Ollama on Windows ONLY (do not use in Docker — compose overrides to /root/.ollama)
OLLAMA_MODELS=E:\aqond-data\ollama

# Docker Desktop disk image — set in Docker Desktop Settings -> Resources -> Disk image location
DOCKER_DATA_ROOT=E:\Docker

# P9-P22 Go commerce core (dev-lite profile)
KAFKA_BROKERS=redpanda:9092
HERMES_USE_RULES_ONLY=1
HERMES_MAX_DAILY_INFERENCES=500

# Legacy meerak auth (shared with g:\meerak\mobile + g:\meerak\backend)
# Storefront Next.js proxy: http://127.0.0.1:3001 (or https://api.aqond.com)
# Kong Docker upstream: http://host.docker.internal:3001 (render-kong-config.ps1 auto-converts localhost)
MEERAK_BACKEND_URL=http://127.0.0.1:3001
# Cloud 2 private IP / URL (legacy server.js) — Kong frozen paths proxy here
CLOUD2_BACKEND_URL=http://127.0.0.1:3001
# Cloud 3 v2 cluster (production private IP; dev uses Docker service names in compose)
CLOUD3_V2_URL=http://bff-svc:8132
# Kong loopback from v2 services for cross-cloud ads (Docker: http://kong:8000)
KONG_INTERNAL_URL=http://127.0.0.1:8000
# Dispatch integration (Bible Phase 3): v2 | v1 | hybrid
DISPATCH_MODE=v2
# Dev JWT bypass on localhost (Bible Phase 4)
AQOND_AUTH_DEV=1
# Storefront BFF proxy — Kong v2 alias (Bible diagram Cloud 3)
# Dev: http://127.0.0.1:8000/api/v2/merchant  |  v1 fallback: http://127.0.0.1:8000/api/v1/bff
BFF_URL=http://127.0.0.1:8000/api/v2/merchant
# Storefront optional v2 alias — /api/v2/merchant, /api/v2/rider-merch (default /api/v1)
# NEXT_PUBLIC_API_V2_PREFIX=/api/v2/merchant
# HS256 secret for mobile meerak_token + Kong JWT consumer (must match backend JWT_SECRET)
MEERAK_JWT_SECRET=CHANGE_ME_same_as_backend_jwt_secret
KONG_JWT_SECRET=CHANGE_ME_same_as_backend_jwt_secret
# NEXT_PUBLIC_AUTH_VIA_KONG=1
# Copy from g:\meerak\mobile\.env VITE_FIREBASE_API_KEY (OTP + web push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aqond-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aqond-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aqond-production.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=187301416431
NEXT_PUBLIC_FIREBASE_APP_ID=1:187301416431:web:774a67a1d8554faccbfa1a
# Web Push VAPID — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Tier 1b notifications (notification-svc)
# Legacy FCM HTTP API key — Firebase Console → Project Settings → Cloud Messaging → Server key
FCM_SERVER_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3003/m/login/line-callback
# Legacy link-after-login (notifications settings):
# LINE_LINK_CALLBACK_URL=http://localhost:3003/m/account/notifications/line-callback
# LINE Messaging API webhook (set in LINE Developers → use Kong public URL in prod)
LINE_WEBHOOK_PUBLIC_URL=http://localhost:8000/api/v1/notify/v1/line/webhook

# OTP / SMS (bff-svc auth) — production: AQOND_OTP_DEV_EXPOSE=0 + real provider
AQOND_OTP_DEV_EXPOSE=1
AQOND_SMS_PROVIDER=log
# thaibulk | twilio | http | log
AQOND_SMS_SENDER=AQOND
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Custom HTTP gateway (POST JSON {phone,code,message})
AQOND_SMS_HTTP_URL=
AQOND_SMS_HTTP_AUTH=
