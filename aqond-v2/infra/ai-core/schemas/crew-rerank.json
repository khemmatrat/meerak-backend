{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ranked"],
  "properties": {
    "ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "score", "reason"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "crew_notes": { "type": "string" }
  }
}
