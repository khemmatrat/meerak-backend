{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["carrier_at_fault", "confidence", "reason", "recommend_refund"],
  "properties": {
    "carrier_at_fault": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "recommend_refund": { "type": "boolean" },
    "recommend_release": { "type": "boolean" }
  },
  "additionalProperties": true
}
