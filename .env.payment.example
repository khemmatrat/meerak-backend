# ==============================================
# Phase 3: Payment Gateway Configuration
# ==============================================
#
# 【ทดสอบด้วย Test Keys】 ใช้ NODE_ENV=development (หรือไม่ตั้ง)
#   - Backend ใช้ PAYMENT_GATEWAY_SECRET_KEY_TEST / PAYMENT_GATEWAY_WEBHOOK_SECRET_TEST เมื่อไม่ใช่ production
#   - ตั้ง PAYMENT_GATEWAY_API_HOST และ header เวอร์ชันตามเอกสารของผู้ให้บริการ
#
# 【เปิดเงินจริง】 ใช้ NODE_ENV=production + Live keys
#   - ใส่ PAYMENT_GATEWAY_SECRET_KEY / PAYMENT_GATEWAY_WEBHOOK_SECRET (live)
#   - AUTO_PAYOUT_GATEWAY_TRANSFER_ENABLED=1 เมื่อพร้อมโอนผ่าน API ของผู้ให้บริการ
#
# ==============================================

# Application URLs
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ==============================================
# Payment processor (gateway-agnostic)
# ==============================================
PAYMENT_GATEWAY_PROVIDER=http

# REST API host สำหรับ charge/source/balance/recipients
PAYMENT_GATEWAY_API_HOST=api.example-payment-processor.test

# Optional API version headers
# PAYMENT_GATEWAY_API_VERSION_HEADER_NAME=
# PAYMENT_GATEWAY_API_VERSION_HEADER_VALUE=

# Test Mode (Development)
PAYMENT_GATEWAY_PUBLIC_KEY_TEST=pkey_test_xxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_SECRET_KEY_TEST=skey_test_xxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_WEBHOOK_SECRET_TEST=whsec_test_xxxxxxxxxxxxxxxxxxxxx

# Live Mode (Production)
PAYMENT_GATEWAY_PUBLIC_KEY=pkey_live_xxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_SECRET_KEY=skey_live_xxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_live_xxxxxxxxxxxxxxxxxxxxx

# PAYMENT_GATEWAY_WEBHOOK_SIGNATURE_HEADER=

# ==============================================
# PaymentProviderGate — Payso vs Ksher (local QR / wallets) + Stripe สำรอง
# อ้างอิงตารางค่าธรรมเนียม (ปรับตามสัญญาล่าสุดกับค่าย)
# — Ksher: PromptPay 0.5% · TrueMoney 2.5% · ShopeePay 3% · WeChat 2% · Alipay 2.5%
#   · บัตรนิติ ~3.2% · บุคคลธรรมดา ~3.5%
# — Payso: PromptPay ~1% · TrueMoney/Alipay/WeChat e-wallet ~3% · ShopeePay ~2.95%
#   · โอนออก ~12–20 บาท/รายการ (ยอดไม่เกินที่ค่ายกำหนด) · ค่าธรรมเนียมมักยังไม่รวม VAT 7%
# — Stripe TH: บัตรในประเทศ ~3.65% + 10 บาท · ต่างประเทศ ~4.75% + 10 บาท
#   · PromptPay ผ่าน Stripe ~1.65% · คืนเงิน ~10 บาท/ครั้ง · FX +2% เมื่อแปลงสกุล
# ==============================================
# PAYMENT_LOCAL_GATEWAY=payso
# PAYMENT_LOCAL_GATEWAY=ksher
# STRIPE_PAYMENT_ENABLED=1
#
# Markup บนงาน Match (ผู้จ้างจ่าย) — ทศนิยม เช่น 0.05 = 5%
# PAYMENT_MATCH_MARKUP_RATE=
# PAYMENT_MATCH_MARKUP_RATE_PAYSO=0.05
# PAYMENT_MATCH_MARKUP_RATE_KSHER=0.05
#
# --- Ksher (ทศนิยม เช่น 0.005 = 0.5%) ---
# PAYMENT_MDR_KSHER_PROMPTPAY_IN=0.005
# PAYMENT_MDR_KSHER_PROMPTPAY_OUT=0.01
# PAYMENT_MDR_KSHER_TRUEMONEY_IN=0.025
# PAYMENT_MDR_KSHER_SHOPEEPAY_IN=0.03
# PAYMENT_MDR_KSHER_WECHAT_IN=0.02
# PAYMENT_MDR_KSHER_ALIPAY_IN=0.025
# PAYMENT_MDR_KSHER_CARD_JURIDICAL_IN=0.032
# PAYMENT_MDR_KSHER_CARD_INDIVIDUAL_IN=0.035
#
# --- Payso ---
# PAYMENT_MDR_PAYSO_PROMPTPAY_IN=0.01
# PAYMENT_MDR_PAYSO_PROMPTPAY_OUT=0.015
# PAYMENT_MDR_PAYSO_TRUEMONEY_IN=0.03
# PAYMENT_MDR_PAYSO_SHOPEEPAY_IN=0.0295
# PAYMENT_PAYSO_PAYOUT_TRANSFER_MIN_THB=12
# PAYMENT_PAYSO_PAYOUT_TRANSFER_MAX_THB=20
#
# --- Stripe (บัตรสำรอง / PromptPay ผ่าน Stripe) ---
# PAYMENT_MDR_STRIPE_CARD_IN=0.0365
# PAYMENT_MDR_STRIPE_CARD_DOMESTIC_IN=0.0365
# PAYMENT_MDR_STRIPE_CARD_INTL_IN=0.0475
# PAYMENT_MDR_STRIPE_PROMPTPAY_IN=0.0165
# PAYMENT_STRIPE_CARD_FIXED_FEE_DOMESTIC_THB=10
# PAYMENT_STRIPE_CARD_FIXED_FEE_INTL_THB=10
# PAYMENT_STRIPE_REFUND_FEE_THB=10
# PAYMENT_STRIPE_FX_SURCHARGE=0.02
# PAYMENT_MDR_STRIPE_PAYOUT_OUT=0.0025

# Webhook Payso — รหัส result_code ที่ถือว่าสำเร็จ (คั่นด้วย comma) ถ้าไม่ตั้งจะใช้ชุด default ในโค้ด
# PAYSO_WEBHOOK_SUCCESS_RESULT_CODES=0,00,0000,SUCCESS
# เก็บ payload เต็มใน payment_transaction_logs.metadata (default เก็บแค่ SHA256) — เปิดเฉพาะตอน debug
# PAYMENT_WEBHOOK_LOG_FULL_PAYLOAD=1

# ==============================================
# Stripe Configuration (Credit/Debit Cards)
# ==============================================

# Test Mode (Development)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_REPLACE_ME
STRIPE_SECRET_KEY_TEST=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET_TEST=whsec_REPLACE_ME

# Live Mode (Production)
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ชื่อบนสรุปรายการบัตร (สูงสุด 22 ตัว) — ต้องตรงกับ VITE_STRIPE_STATEMENT_DESCRIPTOR ใน mobile (ค่า default ในโค้ด = AQOND PLATFORM)
STRIPE_STATEMENT_DESCRIPTOR=AQOND PLATFORM

# ==============================================
# Reconcile Alert Notifications (Line Notify / Email)
# ==============================================
# เมื่อ reconcile-alerts มีรายการใหม่ (ยอดจาก payment processor ไม่ตรงกับ platform_balance)
# ระบบจะส่งแจ้งเตือนอัตโนมัติ

# Line Notify — สร้าง Token ที่ https://notify-bot.line.me/my/
# LINE_NOTIFY_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# Email — ใส่ email เจ้านาย/ทีมบัญชี (หลายคนคั่นด้วย comma)
# ALERT_EMAIL_TO=ceo@aqond.com,accounting@aqond.com

# SMTP (ถ้าต้องการส่ง Email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alert@aqond.com
# SMTP_PASS=xxxxx
# SMTP_FROM=AQOND Alert <alert@aqond.com>

# ==============================================
# Payment Settings
# ==============================================

# Timeout for QR code payments (seconds)
PAYMENT_TIMEOUT=900

# Platform fee percentage (e.g., 5 = 5%)
PLATFORM_FEE_PERCENT=5

# Minimum platform fee (THB)
PLATFORM_MIN_FEE=10

# Maximum platform fee (THB)
PLATFORM_MAX_FEE=1000

# ==============================================
# Webhook URLs (Update these in production)
# ==============================================

# Checkout webhook URL (ลงทะเบียนใน dashboard ของผู้ให้บริการ)
WEBHOOK_URL_CHECKOUT=https://yourdomain.com/api/webhooks/checkout

# Stripe webhook URL (register in Stripe dashboard)
WEBHOOK_URL_STRIPE=https://yourdomain.com/api/payment-gateway/webhook/stripe

# TrueMoney callback URL
CALLBACK_URL_TRUEMONEY=https://yourdomain.com/api/payment-gateway/callback

# ==============================================
# Redis Configuration (for webhook idempotency)
# ==============================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ==============================================
# Database Configuration
# ==============================================

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=meera_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# ==============================================
# Email Notifications (optional)
# ==============================================

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@meerak.app
SENDGRID_FROM_NAME=Meerak Platform

# AWS SES (alternative)
AWS_SES_REGION=ap-southeast-1
AWS_SES_ACCESS_KEY=AKIA...
AWS_SES_SECRET_KEY=...

# ==============================================
# SMS Notifications (optional)
# ==============================================

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+66...

# ==============================================
# Monitoring & Logging
# ==============================================

# Log level
LOG_LEVEL=info

# Enable payment logging
PAYMENT_LOG_ENABLED=true

# Alert email for payment failures
PAYMENT_ALERT_EMAIL=finance@meerak.app

# ==============================================
# Security
# ==============================================

# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# JWT secret (required for admin login)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Admin default email (set-admin-password.js) — รักษา admin@nexus.com ไว้
ADMIN_EMAIL=admin@nexus.com

# Gemini AI (น้องรักษ์ Support Chatbot) — เอา API Key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ==============================================
# Auto Payout Cron (24–36 ชม.)
# ==============================================
# รัน: npm run auto-payout (หรือ cron ทุก 6 ชม.)
# AUTO_PAYOUT_RELEASE_ENABLED=1   # ปล่อย pending → balance เมื่อ release_deadline ครบ
# AUTO_PAYOUT_RELEASE_HOURS=24    # ใช้ร่วมกับ release_deadline ใน job (default 24h)
# AUTO_PAYOUT_GATEWAY_TRANSFER_ENABLED=0   # เปิด=1 เมื่อพร้อมโอนผ่าน gateway API
# AUTO_PAYOUT_JOB_LIMIT=100
# AUTO_PAYOUT_REQUEST_LIMIT=50

# ==============================================
# Feature Flags
# ==============================================

# Enable/disable gateways
ENABLE_PROMPTPAY=true
ENABLE_STRIPE=true
ENABLE_TRUEMONEY=true

# ==============================================
# Go Live: ทดสอบด้วย Test Keys ก่อน
# ==============================================
# - สำหรับทดสอบ: ใช้ NODE_ENV=development + PAYMENT_GATEWAY_*_TEST, STRIPE_*_TEST
# - Production: ใส่ live keys แล้วตั้ง NODE_ENV=production
# - AUTO_PAYOUT_GATEWAY_TRANSFER_ENABLED=1 เมื่อพร้อมโอนผ่าน API
NODE_ENV=development

# ==============================================
# Deploy ประเทศไทย — Ops / Debug / DB (คัดลอกไปตั้งบน Server)
# ==============================================
# --- ปิด debug ตอนขึ้น Production (ค่าแนะนำ) ---
# NODE_ENV=production
# STARTUP_VERBOSE=0
# DEBUG_LOGIN=0
# PAYMENT_WEBHOOK_LOG_FULL_PAYLOAD=0
#
# --- Webhook ยืนยันชำระเงิน (backend) — ลงทะเบียน URL ใน dashboard Payso/Ksher ---
# PAYMENT_WEBHOOK_SECRET=your_hmac_shared_secret
# (ทางเลือกเดิม) PAYMENT_GATEWAY_WEBHOOK_SECRET=...
# Public URL ตัวอย่าง: https://api.yourdomain.com/api/payments/webhook
#
# --- Neon / Postgres ผ่าน DATABASE_URL ---
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# USE_DATABASE_URL=1
# DB_CONNECTION_TIMEOUT_MS=60000
# DATABASE_SSL_DISABLE=0
# PGSSLMODE= (ว่าง = verify; ใช้ no-verify เฉพาะแก้ปัญหาใบรับรองชั่วคราว — ไม่แนะนำ production จริง)
#
# --- Checkout / Stripe webhook (อ้างอิง URL — แก้โดเมนให้ตรง) ---
# WEBHOOK_URL_CHECKOUT=https://api.yourdomain.com/api/webhooks/checkout
# WEBHOOK_URL_STRIPE=https://api.yourdomain.com/api/webhooks/stripe
