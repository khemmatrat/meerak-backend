# =============================================================================
# Meerak / AQOND — gitignore
# อนุญาต: โค้ดเกือบทั้งหมด + README.md + .env.example (+ *.example ที่ชัดเจนว่าเป็นตัวอย่าง)
# ห้าม: docs/, *.md (ยกเว้น README), *.txt, .env จริง, secrets, node_modules, build
# =============================================================================

# --- Dependencies ---
node_modules/
**/node_modules/
.pnp
.pnp.js

# --- Python / brain temp ---
__pycache__/
*.py[cod]
.venv/
venv/
aqond-brain/.tmp_pip_xai/
**/.tmp_pip*/

# --- Build outputs ---
dist/
build/
.next/
out/
coverage/
.turbo/
*.tsbuildinfo

# --- Language / tool caches (ห้ามขึ้น git) ---
.gocache/
**/.gocache/
.gomodcache/
**/.gomodcache/
.go/
**/pkg/mod/
.cache/
**/.cache/
.npm/
**/.npm/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
*.pyc
.parcel-cache/
**/.parcel-cache/
.vercel/
**/.vercel/
android/.gradle/
**/.gradle/
**/local.properties
**/DerivedData/
aqond-v2/.bin/
aqond-v2/bin/
aqond-v2/_restore-snapshots/
**/_restore-snapshots/

# --- Environment / secrets (ห้ามหลุดขึ้น git โดยเด็ดขาด) ---
.env
.env.*
!.env.example
!.env.*.example
!.env.payment.example
!.env.golive.example
**/.env
!**/.env.example
!**/.env.*.example
*.pem
*.p12
*.pfx
*serviceAccount*.json
*firebase-adminsdk*.json
**/credentials.json
**/google-credentials.json
# mobile/Android release signing (ห้าม)
**/*.keystore
**/*.jks
**/keystore.properties
**/local.properties
aqond-key.jks
**/aqond-key.jks

# --- Docs & prose (ยกเว้น README.md + system bootstrap เท่านั้น) ---
docs/*
!docs/aqond-os/
docs/aqond-os/*
!docs/aqond-os/AGENT_BOOTSTRAP.md
**/*.md
!**/README.md
!**/Readme.md
!**/readme.md
!docs/aqond-os/AGENT_BOOTSTRAP.md
!aqond-v2/docs/rider-os/IMPLEMENTATION_MAP.md
!aqond-v2/docs/PROJECT_STATUS_CHECKLIST.md
!aqond-v2/docs/talent-os/TOS-1-REPORT.md
!aqond-v2/docs/talent-os/TOS-2-REPORT.md
!aqond-v2/docs/talent-os/TOS-3-REPORT.md
!aqond-v2/docs/talent-os/TOS-4-REPORT.md
!STATUS_INDEX.md
!CURRENT_STATUS.md
!AGENT_BOOTSTRAP.md
**/*.txt
!**/.env.example
!**/.env.*.example

# --- Logs / debug / agent ---
*.log
npm-debug.log*
debug-*.log
backend/logs/gateway-compliance/*
!backend/logs/gateway-compliance/.gitkeep
backend/uploads/statements/
backend/.data/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Cursor local (ไม่ขึ้น git) ---
.cursor/
.cursorignore

# --- Large / binary media (ห้ามขึ้น public GitHub — ทำให้ push พัง และมี exe ปน) ---
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.exe
*.msi
*.dmg
*.apk
*.aab
*.iso
*.7z
*.rar
aqond-brain/grokVideo/
aqond-brain/output/
aqond-brain/assets/scenes/
mobile-1.2/
dev-test-accounts/

# --- Misc generated ---
.vite/
*.tgz
*.zip
TMP_*.js
TMP_*.mjs
.agent-tools/
