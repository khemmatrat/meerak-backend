# =============================================================================
# AQOND Go Live — ตัวอย่าง .env สำหรับ deploy บน SSH (147.50.231.183)
# =============================================================================
# คัดลอกเป็น .env: cp .env.golive.example .env
# แก้ไข DB_PASSWORD และ JWT_SECRET ให้ปลอดภัย
# =============================================================================

# Database — production ต้องใช้ชื่อฐานข้อมูล meera_db ทุก instance (api + admin ผ่าน API เดียวกัน)
# แบบ A: Docker compose บนเซิร์ฟเวอร์ (ค่า default ใน docker-compose.golive.v12.yml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=meera_db
DB_USER=meera
DB_PASSWORD=changeme_db_password
#
# แบบ B: Neon / managed Postgres — ใช้สายเดียว (ชื่อ db ใน path ต้องเป็น meera_db)
# USE_DATABASE_URL=1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/meera_db?sslmode=require
# (เมื่อ USE_DATABASE_URL=1 backend จะใช้แค่ DATABASE_URL สำหรับ pool — ไม่อ่าน DB_HOST/DB_DATABASE)
#
# ห้ามให้ api.aqond.com กับ admin ชี้ backend คนละ DATABASE_URL / คนละ DB — แบนเนอร์จะไม่ตรงกับ mobile

# JWT — จำเป็นสำหรับ Backend
JWT_SECRET=your-super-secret-jwt-key-change-this

# Environment
NODE_ENV=production

# Admin API URL (default: https://api.aqond.com) — ใช้ IP ชั่วคราวถ้าโดเมนยังไม่พร้อม
# VITE_ADMIN_API_URL=https://api.aqond.com
# VITE_BACKEND_URL=https://api.aqond.com

# Rate Limit (optional — ปรับได้ถ้า login limit เข้มงวดเกินไป)
# LOGIN_LIMIT_PHONE=1500   # ต่อเบอร์/15นาที
# LOGIN_LIMIT_IP=2000      # ต่อ IP/15นาที
# OTP_LIMIT_PHONE=30       # OTP ต่อเบอร์/ชม.

# Tax & Receipt — เลขประจำตัวผู้เสียภาษีบริษัท (แสดงในใบเสร็จ)
# COMPANY_TAX_ID=0-1234-56789-0-1
# COMPANY_PHONE=02-xxx-xxxx

# Optional — ถ้าใช้ payment gateway / Stripe / S3 ฯลฯ ให้เพิ่มตาม .env.payment.example

# =============================================================================
# GigaStore (Rescue Net eSIM) — https://docs.giga.store/api/getting-started
# =============================================================================
# 0 = mock fulfillment (default) | 1 = เรียก API จริง (หักเครดิตร้านบน GigaStore)
# เมื่อ USE_LIVE=1 + CLIENT_ID/SECRET แอป (หน้าโฮม + /rescue-net) ดึงแคตตาล็อกจาก GET …/inventory ตรงกับของใน portal
# GIGASTORE_USE_LIVE=0
# GIGASTORE_API_BASE_URL=https://api.giga.store
# Client ID / Secret จาก portal → API (Basic auth → Bearer token)
# GIGASTORE_CLIENT_ID=
# GIGASTORE_CLIENT_SECRET=
# (ทางเลือก) แมปรหัสเก่า → inventory UUID — ถ้าแคตตาล็อกใช้ UUID จาก GigaStore โดยตรง ไม่ต้องตั้ง
# GIGASTORE_SKU_MAP_JSON={"GS-TH-EMRG-1D-1GB":"<inventory-uuid>"}
# GIGASTORE_DEFAULT_USER_COUNTRY=TH
# optional: ส่ง expectedPrice ตาม retail จาก inventory (กันค่าเปลี่ยนกลางคัน)
# GIGASTORE_USE_EXPECTED_PRICE=0
# GIGASTORE_ACTIVATION_MODE=NOW
# แปลง retail USD → ฐาน THB สำหรับคำนวณมาร์จิ้น (ปรับตามเรทจริง)
# GIGASTORE_THB_PER_USD=36
# จำกัดเฉพาะ countrySet จาก inventory (เช่น TH หรือ WWW) — ว่าง = เอาทั้งหมด
# GIGASTORE_INVENTORY_COUNTRY_SET=
#
# Portal → Support Webhooks (ต้องเป็น HTTPS) — ชี้ไปที่ **Backend API** เท่านั้น
# Go Live: ใช้ https://api.aqond.com/... (ไม่ใช่ app.aqond.com — โดเมนนั้นเป็นเว็บ/แอป)
# IP 147.50.231.183 ใช้ได้เฉพาะถ้ามี HTTPS + cert ถูกต้อง และ reverse proxy ส่งต่อไป Node
#   https://api.aqond.com/api/webhooks/gigastore/esim-status
#   https://api.aqond.com/api/webhooks/gigastore/balance-alert
#   https://api.aqond.com/api/webhooks/gigastore/country-change
#   https://api.aqond.com/api/webhooks/gigastore/balance-activation
#   https://api.aqond.com/api/webhooks/gigastore/customer-registration
# optional: ถ้าตั้งแล้ว ต้องส่ง header X-Gigastore-Webhook-Secret ตรงกับค่านี้
# GIGASTORE_WEBHOOK_SECRET=
