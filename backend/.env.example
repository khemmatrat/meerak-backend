# =============================================================================
# Backend — copy to .env and adjust (see repo root .gitignore: backend/.env local)
# =============================================================================

# --- Admin security (Iron Wall) — รัน migration 152_admin_totp.sql ก่อนเปิด MFA ---
# บังคับ 2FA (TOTP) สำหรับ Admin/Auditor — หลังล็อกอินต้องยืนยันรหัส 6 หลัก
# ADMIN_MFA_REQUIRED=1
# คั่นด้วยจุลภาค — ถ้าไม่ตั้ง = อนุญาตทุก IP (พัฒนา). Production: ใส่ IP ออฟฟิศ/VPN
# ADMIN_IP_WHITELIST=203.0.113.10,198.51.100.0
# ปิดการยกเว้น localhost (ทดสอบ whitelist จริงบนเครื่อง dev)
# ADMIN_IP_ALLOW_LOCALHOST=0
# Webhook JSON เมื่อล็อกอิน admin สำเร็จ/ล้มเหลว (HTTPS)
# ADMIN_SECURITY_WEBHOOK_URL=https://hooks.example.com/admin-security
# ADMIN_SECURITY_WEBHOOK_SECRET=optional_shared_secret
# ส่ง Line Notify (ใช้ LINE_NOTIFY_TOKEN เดียวกับ reconcile) เมื่อมีเหตุการณ์ล็อกอิน admin
# ADMIN_LOGIN_LINE_NOTIFY=1
# อีเมลแจ้งเตือน (ต้องตั้ง SMTP_* / nodemailer)
# ADMIN_LOGIN_ALERT_EMAIL=boss@example.com

# KYC — แจ้งทีม OPS ทันทีเมื่อผู้ใช้ส่งเอกสาร (Slack/Discord incoming webhook ฯลฯ) เพื่อเข้าไปอนุมัติใน Admin ได้เร็ว
# KYC_SUBMISSION_OPS_WEBHOOK_URL=https://hooks.slack.com/services/...
# ถ้า URL รูปจาก CDN ผิดจากรูปแบบในโค้ด (มี path เป็น kyc_uploads เสมอ) ใส่ regex ให้ครอบได้ (ระวัง SSRF — ควบคุมด้วย env)
# KYC_EXTRA_TRUST_IMAGE_URL_REGEX=^https:\/\/cdn\\.yourdom\\.com\/

# Transport Hub — intercity / relay dedicated pricing (default false; keep false until rollout)
TRANSPORT_INTERCITY_PRICING_ENABLED=false
# นาทีหลังรับงานที่ยกเลิก intercity ได้ฟรี — ต้องตรงกับ VITE_INTERCITY_CANCEL_GRACE_MINUTES ใน mobile/.env
# INTERCITY_CANCEL_GRACE_MINUTES=15
# Optional: comma-separated user UUIDs — when non-empty, ONLY these users get intercity engine (beta)
# TRANSPORT_INTERCITY_PRICING_BETA_USER_IDS=
# TRANSPORT_INTERCITY_THB_PER_KM=15
# TRANSPORT_INTERCITY_BASE_SURCHARGE_THB=500
# TRANSPORT_INTERCITY_FLOOR_JOB_FEE_THB=800

# Matching spine — น้ำหนักคะแนน (JSON) + จำกัดงานพร้อมกันต่อ provider (Phase 1.5)
# MATCHING_WEIGHTS_JSON={"category":0.25,"distance":0.25,"grade":0.15,"rating":0.2,"completion":0.1,"cancellation":0.05}
# PROVIDER_MAX_CONCURRENT_JOBS=3
# กรองผู้ให้บริการที่ชน slot กับงานที่รับอยู่ (datetime + duration_hours หรือ start/end) — ปิดด้วย 0 ถ้าต้องการ benchmark
# MATCHING_TIME_CONFLICT_CHECK=1

# หลังงาน completed — แสดงเบอร์โทรฝั่งตรงข้ามได้กี่ชั่วโมง (สอดคล้องข้อความในแชท / ต้องตรงกับ VITE_POST_JOB_PHONE_GRACE_HOURS ใน mobile)
# POST_JOB_PHONE_GRACE_HOURS=24

# Stripe — ชื่อบนสรุปรายการบัตร (สูงสุด 22 ตัว) ต้องตรงกับ VITE_STRIPE_STATEMENT_DESCRIPTOR ใน mobile (ค่า default ในโค้ด = AQOND PLATFORM)
STRIPE_STATEMENT_DESCRIPTOR=AQOND PLATFORM

# AQOND Internal Gateway (migration 146) — HMAC between backend and future gateway service
# INTERNAL_GATEWAY_ENABLED=0
# INTERNAL_GATEWAY_HMAC_SECRET=generate_a_long_random_hex_secret
# Callback URL สำหรับแจ้งหลัก AQOND เมื่อ capture/settle (webhook outbox + retry)
# GATEWAY_WEBHOOK_CALLBACK_URL=https://api.example.com/api/internal-gateway/callback
# GATEWAY_WEBHOOK_HMAC_SECRET=optional_same_as_hmac_for_signature_header
# บังคับ Idempotency-Key ตอนสร้างธุรกรรมผ่าน createGatewayTransaction (Stripe-style)
# INTERNAL_GATEWAY_IDEMPOTENCY_REQUIRED=0
# INTERNAL_GATEWAY_IDEMPOTENCY_TTL_HOURS=24

# PostgreSQL pool (concurrent signups / API)
# DB_POOL_MAX=40
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONN_TIMEOUT_MS=10000

# Closed beta — first N signups get cohort badge + welcome notification (migration 149)
# BETA_TESTER_MAX_SLOTS=100

# Optional Sentry (npm i @sentry/node)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Support tickets (migration 182) — แจ้งแอดมินเมื่อมีตั๋ว/ข้อความใหม่ ---
# Slack Incoming Webhook (ข้อความ plaintext)
# SUPPORT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# อีเมลเฉพาะ Support (ถ้าไม่ตั้ง จะใช้ ALERT_EMAIL_TO จาก alertNotifier)
# SUPPORT_ALERT_EMAIL_TO=support-ops@example.com

# --- Tier 4: Ops weekly digest (รวม MRK + reconcile + partner) ---
# OPS_WEEKLY_DIGEST_WEBHOOK_URL=https://hooks.slack.com/services/...
# Tier 5 — ส่งอีเมลเมื่อ Slack ล้มเหลวหรือกด force จาก Admin
# OPS_WEEKLY_DIGEST_EMAIL_TO=ops@example.com

# --- Executive daily CSV report (Finance/CEO) ---
# ปกติจะตั้งค่า schedule ผ่าน Admin UI + DB (system_settings.executive_daily_report_schedule)
# ENV ด้านล่างใช้เป็น fallback เมื่อยังไม่ตั้งในหน้า Admin
# ค่าดีฟอลต์ 30 วัน (กำหนดได้ 7-30)
# EXECUTIVE_DAILY_REPORT_WINDOW_DAYS=30
# ใส่หลายอีเมลคั่น comma
# EXECUTIVE_DAILY_REPORT_EMAIL_TO=ceo@example.com,cfo@example.com
# ตัว backend มี scheduler ในตัว (ทุก 5 นาที) ไม่ต้องตั้ง OS cron เพิ่ม

# --- Tier 5: Users list reconcile snapshot (pass/warn ในตาราง ไม่ต้องเปิด modal) ---
# ปิดถ้า list ช้า: ADMIN_USERS_LIST_RECONCILE=0
# ADMIN_USERS_LIST_RECONCILE=1

# --- Tier 5: Partner API auto-suspend เมื่อชน weekly quota ซ้ำหลายวัน ---
# PARTNER_API_AUTO_SUSPEND_ON_QUOTA=1
# PARTNER_API_QUOTA_SUSPEND_MIN_DAYS=3

# --- Support case auto-assign (Tier 2) — urgent → ops queue, high → round-robin ---
# SUPPORT_CASE_AUTO_ASSIGN=1
# SUPPORT_CASE_OPS_QUEUE=ops-lead@example.com
# SUPPORT_CASE_ROUND_ROBIN=admin1@example.com,admin2@example.com

# --- Support cases MRK-* (migration 229) — Slack เมื่อเปิด/assign/close case ---
# ลำดับ webhook: SUPPORT_CASE_SLACK_WEBHOOK_URL → SUPPORT_SLACK_WEBHOOK_URL → SLACK_WEBHOOK_URL
# SUPPORT_CASE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ADMIN_APP_URL=https://admin.example.com  (ลิงก์ใน Slack ไปหน้า support-cases / users)

# --- Partner API dashboard alerts (Tier 1) — Slack เมื่อ error rate / 429 สูง ---
# PARTNER_API_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PARTNER_API_ALERT_ERROR_RATE_PCT=15
# PARTNER_API_ALERT_429_MIN=3
# PARTNER_API_ALERT_MIN_ERRORS=2
# Partner API weekly trust report (Tier 3) — cron: node scripts/run_partner_api_weekly_report.js
# PARTNER_API_WEEKLY_SLACK_WEBHOOK_URL=...  (fallback PARTNER_API_SLACK_WEBHOOK_URL / SLACK_WEBHOOK_URL)
# PARTNER_API_WEEKLY_EMAIL_TO=ops@example.com
# PARTNER_API_WEEKLY_QUOTA_REQUESTS=50000

# --- Reconcile trend (Tier 3) — repeat reconcile fail → Security badge + urgent case ---
# RECONCILE_TREND_WINDOW_DAYS=30
# RECONCILE_TREND_MIN_FAILS=2

# --- Reconcile fail alerts (migration 229) — แจ้งเมื่อ wallet reconcile ไม่ตรง ---
# ใช้ตัวใดตัวหนึ่ง (ลำดับ: SLACK → DISCORD → RECONCILE_ALERT)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# RECONCILE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ADMIN_APP_URL=https://admin.example.com
# Email fallback เมื่อ Slack ล้มเหลวหรือไม่ได้ตั้ง webhook (ใช้ SMTP_* + ALERT_EMAIL_TO)
# RECONCILE_ALERT_EMAIL_TO=finance-ops@example.com

# --- Smart Anti-Bypass (PR-1 text core + admin rules; PR-2 proxy job chat; PR-3 chat image) ---
# off | warn | block — default off (ไม่กระทบ traffic จนกว่าจะ rollout)
# ANTI_BYPASS_TEXT_FILTER=off
# in-process counters; evaluate-test อาจ increment เมื่อมี hit (ไม่เก็บข้อความดิบ)
# ANTI_BYPASS_TELEMETRY=off
# (PR-3) off | block — chat uploads with body.tag=chat: QR reject + Gemini OCR → evaluate scope image_ocr (rules + built-ins); default off (parity)
# ANTI_BYPASS_IMAGE_FILTER=off
# Gemini OCR — same key as Job proof vision (required when IMAGE_FILTER=block unless CHAT_IMAGE_OCR_FAIL_OPEN=1)
# GEMINI_API_KEY=
# optional override CHAT_IMAGE_OCR_MODEL=gemini-2.0-flash
# 1 = if OCR unreachable, still allow upload when IMAGE_FILTER=block (weaker rollout only)
# CHAT_IMAGE_OCR_FAIL_OPEN=0
# (PR-2) Enable proxied writes for POST /api/jobs/:jobId/chat/messages — must match mobile VITE_ANTI_BYPASS_JOB_CHAT_PROXY
# ANTI_BYPASS_JOB_CHAT_PROXY=off

# --- Referral invite links (GET /api/referral/me → referralLink) ---
# ถ้าไม่ตั้ง จะใช้ LANDING_URL → FRONTEND_URL → https://aqond.com ตามลำดับ
# REFERRAL_LINK_BASE_URL=https://app.aqond.com

# --- Growth Engine — Talent AI Resume (Phase 1, aqond-ai-studio LivePortrait + TTS) ---
# AQOND_AI_STUDIO_URL=http://127.0.0.1:8000
# AQOND_AI_STUDIO_API_KEY=AQOND_STUDIO_SECRET_SHA256_PASS

# --- Growth Incubation — weekly Hermes brief (Phase 2, ai-core) ---
# AI_CORE_URL=http://127.0.0.1:8100
# AI_CORE_API_KEY=
# OS Super App chat: Hermes (+ Jarvis) → Qwen Thai (ai-core /v1/os/chat, else local Ollama)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL_CHAT=hermes3:3b
# OLLAMA_MODEL_PROSE=qwen2.5:7b-instruct
# OS_CHAT_TIMEOUT_MS=90000
# OS_CHAT_AI_CORE=0          # force skip ai-core
# OS_CHAT_OLLAMA=0           # force skip local Ollama

# Pro Toolkit Phase 2b — AI product video (auto uses Replicate when token set)
# AQOND_PRO_VIDEO_PROVIDER=auto
# REPLICATE_API_TOKEN=
# AQOND_PRO_VIDEO_REPLICATE_MODEL=minimax/video-01
# AQOND_PRO_VIDEO_DEMO_URL=https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4
# OS_CHAT_ALLOW_GEMINI=1     # optional last resort
# OS_CHAT_JARVIS=0           # disable Jarvis commerce pass in ai-core
# OS_CHAT_QWEN=0             # disable Qwen polish in ai-core (Hermes/rules only)

# --- Merchant Top 10 weekly ranking (Phase 4) ---
# MERCHANT_TOP10_PROMO_BATCH=1   # optional: ping ai-core jarvis for top-shop promo batch

# --- Wallet deposit — PaySo Mobile / Internet Banking (None-UI path from Pay Solutions merchant doc) ---
# PaySo — บัตรเครดิต (TEP ที่ apis.paysolutions.asia/tep) ใช้คีย์จาก merchant dashboard โดยตรง
# PAYSO_ENABLED=1
# PAYSO_API_BASE_URL=https://apis.paysolutions.asia/tep
# PAYSO_MERCHANT_ID=
# PAYSO_API_KEY=              # Auth Key (JWT) — PromptPay/Mobile Banking ฝากเงิน (bearer) เท่านั้น
# PAYSO_SECRET_KEY=           # Secret Key จากหน้า PaySo (หรือใช้ PAYSO_MERCHANT_SECRET_KEY)
# PAYSO_PUBLIC_KEY=           # API Key จากหน้า PaySo (หรือใช้ PAYSO_INQUIRY_API_KEY) — ไม่ต้องเป็น pkey_
# PAYSO_MERCHANT_SECRET_KEY=  # alias ของ Secret Key
# PAYSO_INQUIRY_API_KEY=      # alias ของ API Key
# PAYSO_CARD_PAYMENT_URL=https://www.thaiepay.com/epaylink/payment.aspx
# PAYSO_CARD_PAYMENT_LANG=t
# PAYSO_CARD_CURRENCY_CODE=00
# Pre-select channel on thaiepay hosted page (optional — code defaults shown below)
# PAYSO_TRUEMONEY_REDIRECT_FORM_JSON={"paymenttype":"truemoney"}
# PAYSO_MOBILE_BANKING_REDIRECT_FORM_JSON={"paymenttype":"ibanking"}
# Note: cc=00 means THB currency (WooCommerce plugin), NOT payment channel.
# PAYSO_CARD_SDK_URL=https://cdn.omise.co/omise.js
# PAYSO_CARD_SDK_GLOBAL=Omise
# (ทางเลือก) PAYMENT_GATEWAY_* ยัง override ได้ถ้าตั้งไว้
# Often different from PromptPay; if pointed at promptpaynew, PaySo returns a QR payload — app shows PaySo QR step (not bank redirect).
# PAYSO_MOBILE_BANKING_BANK_QUERY_KEY=bankCode
# PAYSO_MOBILE_BANKING_ACCOUNT_QUERY_KEY=bankAccountNo
# PAYSO_MOBILE_BANKING_BANK_MAP_JSON={"scb":"SCB","kbank":"KBANK"}
# Omise-compatible fallback when PaySo MB fails or path unset — default off (PaySo-first)
# PAYMENT_GATEWAY_MOBILE_BANKING_FALLBACK=0

# --- AQOND Ads Platform (Social Core SSOT + meerak bridge) ---
# SOCIAL_CORE_API_URL=http://127.0.0.1:3010
# ADS_SERVICE_API_KEY=your_service_key
# ADS_ROLLOUT_STAGE=production
#   internal | beta | production — beta/internal cap campaign spend (see below)
# ADS_BETA_AUTO_MODERATE=1         # beta/internal only: creative APPROVED on create (no admin queue)
# E2E outcome billing (dev): npm run verify:ads-outcome:dry && npm run verify:ads-outcome
# ADS_FEED_INJECTION_ENABLED=1
# ADS_BETA_MAX_CAMPAIGN_SPEND_THB=300
# ADS_INTERNAL_MAX_CAMPAIGN_SPEND_THB=50
# ADS_SLOT_CACHE_TTL_SEC=90
# ADS_SLOT_CACHE_STALE_SEC=300
# ADS_CIRCUIT_OPEN_SEC=30
# ADS_CIRCUIT_FAILURE_THRESHOLD=5
# ADS_ASYNC_TRANSCODE=0
# ADS_CREATIVE_WORKER_CONCURRENCY=2
# ADS_CDN_BASE_URL=https://cdn.example.com
# Scale schedulers (ops — set =1 on production worker / API node)
# ADS_DAILY_RECON_ENABLED=1       # nightly billing reconciliation
# ADS_OPTIMIZATION_ENABLED=1      # auto-pause / warn low CVR (12h)
# ADS_WAREHOUSE_ENABLED=1         # outbox → ClickHouse/postgres warehouse (5m)
# ADS_ESCROW_EXPIRY_ENABLED=1     # release expired campaign escrow (12h)
# ClickHouse prod warehouse (optional — omit to use postgres ads_warehouse_events)
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# ADS_CLICKHOUSE_TABLE=ads_events
# Setup: clickhouse-client < backend/scripts/clickhouse-ads-setup.sql
# Verify: node backend/scripts/verify-ads-clickhouse.js
# ADS_VERIFY_OUTCOME_E2E=1        # server verify script bills 0.05 THB on latest campaign

# --- Sprint 30 — Experience Engine / FTX rollout ---
# AIVOS_EXPERIENCE_ENABLED=1
# AIVOS_EXPERIENCE_FTX=1
# AIVOS_JARVIS_PROACTIVE=1
# AIVOS_JARVIS_LANG_INTEL=1
# AIVOS_JARVIS_MEMORY=1
# AIVOS_JARVIS_PERSONA=1
# AIVOS_JARVIS_TONE=1
# AIVOS_JARVIS_VOICE=1
# STOREFRONT_INTERNAL_URL=http://127.0.0.1:3003
# AIVOS_EXPERIENCE_TOUR=1
# Instant rollback (disables experience_engine + ftx_overlay):
# AIVOS_EXPERIENCE_KILL=1

# --- Partner onboarding nudge (Phase 3) — proactive reminders for stalled onboarding ---
# Master switch: cron only runs when = 1 (off by default; smoke test uses force)
# NUDGE_ENABLED=0
# How often the cron scans for stalled onboarding (minutes, min 5)
# NUDGE_CRON_MINUTES=60
# Eligible after this many hours of inactivity
# NUDGE_STALL_HOURS=24
# Min gap between two nudges for the same user (=> ~1/day)
# NUDGE_COOLDOWN_HOURS=24
# Max nudges per user per day (enforced via cooldown)
# NUDGE_MAX_PER_DAY=1
# Lifetime cap: stop nudging the same onboarding after this many (anti-spam)
# NUDGE_MAX_TOTAL=3
# Max rows processed per cycle
# NUDGE_BATCH_LIMIT=200
# LINE Messaging API push token — without it, LINE nudges degrade to log (FCM still works)
# LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- Rider OS (dispatch + credit topup) ---
# DISPATCH_SVC_URL=http://127.0.0.1:8085
# Hourly batch reconcile pending Rider PromptPay topups (set 0 to disable)
# RIDER_CREDIT_RECONCILE_CRON=1
# RIDER_CREDIT_RECONCILE_INTERVAL_MS=3600000
# RIDER_CREDIT_RECONCILE_BATCH_LIMIT=100

# --- Rider OS Face Verify (Level B standard / Level C strong) ---
# Face match: rekognition (needs AWS_*) or dev_stub (local — liveness only)
# RIDER_FACE_MATCH_MODE=dev_stub
# RIDER_FACE_MATCH_THRESHOLD=0.85
# RIDER_FACE_DEV_STUB_ALWAYS_PASS=1
#
# PRODUCTION (AWS Rekognition CompareFaces): set mode=rekognition + AWS creds.
# Enrolled KYC portraits stored on S3 are fetched via GetObject (AWS_S3_BUCKET);
# non-S3 portrait URLs fall back to https fetch. If AWS creds are present the mode
# auto-resolves to rekognition even without RIDER_FACE_MATCH_MODE.
# RIDER_FACE_MATCH_MODE=rekognition
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=aqond-uploads
# Session TTL after successful verify (hours)
# RIDER_FACE_SESSION_TTL_HOURS=8
# Passenger job re-verify window (minutes)
# RIDER_FACE_PASSENGER_TTL_MINUTES=30
# กิจวัตรพื้นฐาน: สแกนหน้าเช้าวันละครั้ง (ตอกบัตรเข้างาน)
# RIDER_FACE_DAILY_TZ=Asia/Bangkok
# RIDER_FACE_DAILY_RESET_HOUR=6
# Strong: ตรวจเข้มงวดทุก N วัน (default 3)
# RIDER_FACE_STRICT_REVERIFY_DAYS=3
# Standard: ตรวจเข้มงวดทุก N วัน (default 5)
# RIDER_FACE_STRICT_REVERIFY_DAYS_STANDARD=5
# (deprecated) RIDER_FACE_REVERIFY_INTERVAL_HOURS=6
# Block high-COD jobs until face verify (micro THB×100)
# RIDER_FACE_HIGH_COD_MICRO=1000000
# Strong: vehicles that trigger Level C (comma-separated)
# RIDER_FACE_STRONG_VEHICLE_TYPES=public_transport,van
# Strong: max GPS drift from bind point (km) before suspend
# RIDER_FACE_GPS_BIND_MAX_KM=50
# Optional (genuinely optional): also compare selfie to ID card front face
# RIDER_FACE_COMPARE_ID_CARD=0
# REQUIRED BEFORE PRODUCTION — fraud/suspend alerting to Nexus Admin.
# This is the notification channel when a face mismatch/device-GPS anomaly is
# detected and a rider is auto-suspended. Do NOT ship to production without it.
# RIDER_FACE_INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/...
# RIDER_FACE_INCIDENT_WEBHOOK_SECRET=optional
# RIDER_FACE_ALERT_EMAIL=ops@example.com
