# =============================================================================
# Backend — copy to .env and adjust (see repo root .gitignore: backend/.env local)
# =============================================================================

# --- Admin security (Iron Wall) — รัน migration 152_admin_totp.sql ก่อนเปิด MFA ---
# บังคับ 2FA (TOTP) สำหรับ Admin/Auditor — หลังล็อกอินต้องยืนยันรหัส 6 หลัก
# ADMIN_MFA_REQUIRED=1
# คั่นด้วยจุลภาค — ถ้าไม่ตั้ง = อนุญาตทุก IP (พัฒนา). Production: ใส่ IP ออฟฟิศ/VPN
# ADMIN_IP_WHITELIST=203.0.113.10,198.51.100.0
# ปิดการยกเว้น localhost (ทดสอบ whitelist จริงบนเครื่อง dev)
# ADMIN_IP_ALLOW_LOCALHOST=0
# Webhook JSON เมื่อล็อกอิน admin สำเร็จ/ล้มเหลว (HTTPS)
# ADMIN_SECURITY_WEBHOOK_URL=https://hooks.example.com/admin-security
# ADMIN_SECURITY_WEBHOOK_SECRET=optional_shared_secret
# ส่ง Line Notify (ใช้ LINE_NOTIFY_TOKEN เดียวกับ reconcile) เมื่อมีเหตุการณ์ล็อกอิน admin
# ADMIN_LOGIN_LINE_NOTIFY=1
# อีเมลแจ้งเตือน (ต้องตั้ง SMTP_* / nodemailer)
# ADMIN_LOGIN_ALERT_EMAIL=boss@example.com

# Transport Hub — intercity / relay dedicated pricing (default false; keep false until rollout)
TRANSPORT_INTERCITY_PRICING_ENABLED=false
# นาทีหลังรับงานที่ยกเลิก intercity ได้ฟรี — ต้องตรงกับ VITE_INTERCITY_CANCEL_GRACE_MINUTES ใน mobile/.env
# INTERCITY_CANCEL_GRACE_MINUTES=15
# Optional: comma-separated user UUIDs — when non-empty, ONLY these users get intercity engine (beta)
# TRANSPORT_INTERCITY_PRICING_BETA_USER_IDS=
# TRANSPORT_INTERCITY_THB_PER_KM=15
# TRANSPORT_INTERCITY_BASE_SURCHARGE_THB=500
# TRANSPORT_INTERCITY_FLOOR_JOB_FEE_THB=800

# Matching spine — น้ำหนักคะแนน (JSON) + จำกัดงานพร้อมกันต่อ provider (Phase 1.5)
# MATCHING_WEIGHTS_JSON={"category":0.25,"distance":0.25,"grade":0.15,"rating":0.2,"completion":0.1,"cancellation":0.05}
# PROVIDER_MAX_CONCURRENT_JOBS=3
# กรองผู้ให้บริการที่ชน slot กับงานที่รับอยู่ (datetime + duration_hours หรือ start/end) — ปิดด้วย 0 ถ้าต้องการ benchmark
# MATCHING_TIME_CONFLICT_CHECK=1

# หลังงาน completed — แสดงเบอร์โทรฝั่งตรงข้ามได้กี่ชั่วโมง (สอดคล้องข้อความในแชท / ต้องตรงกับ VITE_POST_JOB_PHONE_GRACE_HOURS ใน mobile)
# POST_JOB_PHONE_GRACE_HOURS=24

# Stripe — ชื่อบนสรุปรายการบัตร (สูงสุด 22 ตัว) ต้องตรงกับ VITE_STRIPE_STATEMENT_DESCRIPTOR ใน mobile (ค่า default ในโค้ด = AQOND PLATFORM)
STRIPE_STATEMENT_DESCRIPTOR=AQOND PLATFORM

# AQOND Internal Gateway (migration 146) — HMAC between backend and future gateway service
# INTERNAL_GATEWAY_ENABLED=0
# INTERNAL_GATEWAY_HMAC_SECRET=generate_a_long_random_hex_secret
# Callback URL สำหรับแจ้งหลัก AQOND เมื่อ capture/settle (webhook outbox + retry)
# GATEWAY_WEBHOOK_CALLBACK_URL=https://api.example.com/api/internal-gateway/callback
# GATEWAY_WEBHOOK_HMAC_SECRET=optional_same_as_hmac_for_signature_header
# บังคับ Idempotency-Key ตอนสร้างธุรกรรมผ่าน createGatewayTransaction (Stripe-style)
# INTERNAL_GATEWAY_IDEMPOTENCY_REQUIRED=0
# INTERNAL_GATEWAY_IDEMPOTENCY_TTL_HOURS=24

# PostgreSQL pool (concurrent signups / API)
# DB_POOL_MAX=40
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONN_TIMEOUT_MS=10000

# Closed beta — first N signups get cohort badge + welcome notification (migration 149)
# BETA_TESTER_MAX_SLOTS=100

# Optional Sentry (npm i @sentry/node)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Support tickets (migration 182) — แจ้งแอดมินเมื่อมีตั๋ว/ข้อความใหม่ ---
# Slack Incoming Webhook (ข้อความ plaintext)
# SUPPORT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# อีเมลเฉพาะ Support (ถ้าไม่ตั้ง จะใช้ ALERT_EMAIL_TO จาก alertNotifier)
# SUPPORT_ALERT_EMAIL_TO=support-ops@example.com
