{
  "type": "module",
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 server.js",
    "stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-server.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File ./scripts/restart-server.ps1",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --test __tests__/buildMeta.test.js __tests__/verifyFirebaseIdTokenPublic.node.test.js __tests__/homeBannersPlacement.test.js __tests__/walletManualDeposit.mapping.test.js __tests__/taxDocumentService.test.js __tests__/payoutWithdrawalFee.test.js __tests__/antiBypassTextFilter.test.js __tests__/jobChatMessagesRoute.test.js __tests__/chatImageAntiBypass.test.js",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t kyc-backend .",
    "docker:run": "docker run -p 3001:3001 kyc-backend",
    "migrate": "psql $DATABASE_URL -f src/database/schema-categories-fixed.sql",
    "migrate:financial": "node scripts/run-migration.js 013",
    "migrate:audit": "node scripts/run-migration.js 014",
    "auto-payout": "node scripts/auto-payout-cron.js",
    "marine-no-checkin": "node scripts/marine-no-checkin-cron.js",
    "brand-adviser-cron": "node scripts/brand-adviser-activity-cron.js",
    "prb-lifecycle": "node scripts/prb-order-lifecycle-cron.js",
    "gold-lotto-draw": "node scripts/gold-lotto-draw-cron.js",
    "verify:ads-outcome": "node scripts/verify-ads-outcome-e2e.js",
    "verify:ads-outcome:dry": "node scripts/verify-ads-outcome-e2e.js --dry-run",
    "verify:ads-clickhouse": "node scripts/verify-ads-clickhouse.js",
    "executive-daily-report": "node scripts/run_executive_daily_csv_report.js",
    "logs:error": "powershell -NoProfile -Command \"Get-Content -Path (Join-Path (Split-Path (Get-Location) -Parent) 'logs' 'error.log') -Wait -Tail 50\"",
    "logs:combined": "powershell -NoProfile -Command \"Get-Content -Path (Join-Path (Split-Path (Get-Location) -Parent) 'logs' 'combined.log') -Wait -Tail 50\"",
    "postinstall": "echo Skipping migrate"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@google/generative-ai": "^0.21.0",
    "@sentry/node": "^8.55.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.11.2",
    "firebase-admin": "^12.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "otplib": "^13.4.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.2",
    "stripe": "^20.4.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-validator": "^3.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.2",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "ระบบ backend สำหรับแพลตฟอร์มบริการ",
  "keywords": [],
  "author": "Khem",
  "license": "ISC"
}
