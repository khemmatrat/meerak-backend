# =============================================================================
# คัดลอกไฟล์นี้เป็น mobile/.env.production แล้วเติมค่าจริง
# (ไฟล์ .env.production ถูก gitignore — ไม่ commit)
#
# ใช้กับ: npm run build:production หรือ npm run android:pre-release
# =============================================================================

# API จริง — ห้ามใช้ localhost / 127.0.0.1 ใน APK ที่จะให้ทีมหรือสาธารณะทดสอบ
VITE_BACKEND_URL=https://api.aqond.com
# ถ้าใช้ staging แบบ http://IP:port ชั่วคราว (ก่อนปล่อยสาธารณะ)
# MEERAK_ALLOW_HTTP_BACKEND=1

# Firebase (Phone OTP) — ต้องตรงโปรเจกต์ที่เปิด Phone Auth + SHA-256 ของ keystore ใน Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aqond-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aqond-production
VITE_FIREBASE_STORAGE_BUCKET=aqond-production.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=187301416431
VITE_FIREBASE_APP_ID=1:187301416431:web:774a67a1d8554faccbfa1a

# ถ้าต้องการข้ามการตรวจ Firebase ชั่วคราว (เช่น CI ไม่มี key): MEERAK_SKIP_FIREBASE_CHECK=1
