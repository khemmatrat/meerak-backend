# =============================================================================
# Mobile App — ตัวอย่าง .env (ไม่มีรหัสจริง ห้าม commit .env)
# =============================================================================
# คัดลอก: cp .env.example .env แล้วเติมค่าจริงจาก Firebase Console
#
# ก่อนขึ้น Play / ให้ทีมทดสอบ APK: คัดลอก env.production.sample → .env.production แล้วรัน npm run android:pre-release
#
# โดเมนที่โฮสต์เว็บแอป (ใช้แสดง URL ในหน้า /account-deletion สำหรับ Google Play — ถ้าไม่ตั้งจะใช้ https://app.aqond.com)
# VITE_PUBLIC_WEB_APP_URL=https://app.aqond.com
# =============================================================================

# Backend API URL (production หลัง deploy)
VITE_BACKEND_URL=https://api.aqond.com
# ถ้า dev บน localhost:3000 แต่ไม่ได้รัน node server.js บนเครื่อง — ใช้บรรทัดบน (api.aqond.com) จะได้พฤติกรรมเดียวกับ app.aqond.com ไม่ต้องพึ่ง localhost:3001
# ทดสอบกับ backend บนเครื่อง: VITE_BACKEND_URL=http://localhost:3001
#
# Android/iOS (Capacitor): ถ้าไม่ตั้ง VITE_BACKEND_URL หรือตั้งเป็น localhost — แอปจะใช้ https://api.aqond.com อัตโนมัติ
# (localhost บนโทรศัพท์ไม่ใช่เครื่อง dev จึงทำให้ login ค้าง)
# ทดสอบกับ backend บน PC: ใช้ IP ใน LAN เช่น VITE_BACKEND_URL=http://192.168.1.10:3001
# หรือ adb reverse แล้วเปิด VITE_ALLOW_LOOPBACK_ON_NATIVE=1 พร้อม VITE_BACKEND_URL=http://localhost:3001
# VITE_ALLOW_LOOPBACK_ON_NATIVE=1

# Firebase (Phone OTP Auth) — ค่าจริงจาก Firebase Console
# https://console.firebase.google.com → Project Settings → General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aqond-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aqond-production
VITE_FIREBASE_STORAGE_BUCKET=aqond-production.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=187301416431
VITE_FIREBASE_APP_ID=1:187301416431:web:774a67a1d8554faccbfa1a
VITE_FIREBASE_MEASUREMENT_ID=G-MRBNTZDY8E

# Payment gateway (client) — public key + card SDK (URL and global object name from your processor docs)
# VITE_PAYMENT_GATEWAY_PUBLIC_KEY=
# VITE_PAYMENT_GATEWAY_CARD_SDK_URL=
# VITE_PAYMENT_GATEWAY_CARD_SDK_GLOBAL=

# ── ผู้ประกอบการ / นิติบุคคล (หน้า /terms, /privacy, Footer)
# individual = บุคคลธรรมดา | company = จดบริษัทแล้ว
# VITE_LEGAL_ENTITY_TYPE=individual
# VITE_COMPANY_LEGAL_NAME=เขมฑัต ไชยปัญหา
# VITE_COMPANY_ADDRESS_TH=539 ร้านตัดผมแหม่มจรัญฯ95/1 แขวงบางอ้อ เขตบางพลัด กรุงเทพมหานคร 10700
# ทะเบียนพาณิชย์อิเล็กทรอนิกส์ (DBD) บนหน้าเว็บ — เช่น อยู่ระหว่างดำเนินการ
# VITE_ECOMMERCE_REGISTRATION_STATUS=อยู่ระหว่างดำเนินการ
# บุคคลธรรมดา: คำอธิบายสถานะ (ไม่ใส่เลขบัตรประชาชนบนหน้าเว็บ)
# VITE_LEGAL_REGISTRATION_NOTE=ดำเนินการในฐานะบุคคลธรรมดา — ...
# นิติบุคคล: เลขทะเบียนพาณิชย์ (ใช้เมื่อ VITE_LEGAL_ENTITY_TYPE=company)
# VITE_COMPANY_REGISTRATION_NO=
# VITE_COMPANY_LEGAL_EMAIL=support@aqond.com
# LINE Official Account — แสดงในการตั้งค่า / โมดอล QR (ไม่ใช้เบอร์โทรเป็น LINE ID เพื่อกันการโทรกวน)
# VITE_COMPANY_LINE_HANDLE=@717qqpte
# VITE_COMPANY_LINE_ID=@717qqpte
# VITE_COMPANY_LINE_URL=https://lin.ee/Y1RPFyV
# VITE_COMPANY_LINE_QR_URL=https://qr-official.line.me/gs/M_717qqpte_GW.png?oat_content=qr
# VITE_INTERCITY_CANCEL_GRACE_MINUTES=15
# ชั่วโมงหลังงาน completed ที่ยังแสดงเบอร์โทร (ต้องตรงกับ POST_JOB_PHONE_GRACE_HOURS ใน backend)
# VITE_POST_JOB_PHONE_GRACE_HOURS=24
# สรุปธุรกิจสำหรับ Stripe (ไม่ตั้ง = สร้างอัตโนมัติจาก VITE_COMPANY_*)
# VITE_STRIPE_BUSINESS_DESCRIPTION=
# ชื่อบนสรุปรายการบัตร (สูงสุด 22 ตัวอักษร) — ต้องตรงกับ STRIPE_STATEMENT_DESCRIPTOR ใน backend (ค่า default ในโค้ด = AQOND PLATFORM)
VITE_STRIPE_STATEMENT_DESCRIPTOR=AQOND PLATFORM

# แชทกับผู้จ้างก่อนกดรับงาน (งาน OPEN) — ตั้งเป็น 0 เพื่อปิด
# VITE_CHAT_BEFORE_ACCEPT=1
