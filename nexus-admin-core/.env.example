# Backend Admin API — ใช้ทั้ง dev proxy และ embed ตอน production build (nexus-admin-core)
# Dev (vite proxy → backend): http://localhost:3001
# Production: ใช้ไฟล์ .env.production ใน repo (https://api.aqond.com) หรือตั้งตอน CI
# ถ้า build production แต่ใส่ localhost ที่นี่โดยไม่ตั้งใจ — โค้ดจะบังคับใช้ https://api.aqond.com
VITE_ADMIN_API_URL=http://localhost:3001

# รูปและชื่อผู้ก่อตั้งในแถบบน (ถ้า API ส่ง avatar_url / full_name แล้วจะใช้จาก API ก่อน)
# ใส่ URL รูปเต็ม หรือวางไฟล์ใน public/ แล้วใช้ path เช่น /founder-avatar.png
# VITE_ADMIN_AVATAR_URL=https://example.com/founder.jpg
# VITE_ADMIN_DISPLAY_NAME=ชื่อที่แสดงในแถบบน

# Firebase (ห้ามใส่ค่าจริงใน Git — คัดลอกไปใส่ใน .env หรือ .env.local)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
