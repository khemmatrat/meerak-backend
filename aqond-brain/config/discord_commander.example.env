# เพิ่มใน aqond-brain/.env (หรือ Environment= ใน systemd)

# Bot จาก https://discord.com/developers/applications — เปิด Message Content Intent
DISCORD_BOT_TOKEN=

# ถ้าเว้นว่าง = ฟังตามชื่อห้อง commander + general (พิมพ์ !navy ใน #general ได้)
# ถ้าใส่ ID = ฟังเฉพาะห้องนั้น (หลายห้องคั่นด้วย comma)
# DISCORD_COMMANDER_CHANNEL_ID=
# DISCORD_COMMANDER_CHANNEL_NAMES=commander,general

# (ทางเลือก) จำกัดเซิร์ฟ
# DISCORD_COMMANDER_GUILD_ID=
# AQOND Community Center — guild id (อ้างอิง): 1492015445363003516

# เมื่อพิมพ์ !all start บนเซิร์ฟเวอร์ — ชื่อ unit ที่ systemctl start (คั่นด้วยช่องว่าง)
# AQOND_SYSTEMD_UNITS=aqond-orchestrator.service pinky-watch.service
