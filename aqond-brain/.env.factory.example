# Video Production Factory — API Keys & Tokens

# === Mock Mode (ทดสอบโดยไม่เรียก API — ใช้ FFmpeg synthetic เท่านั้น) ===
# FACTORY_MOCK_MODE=1

# === Anthropic Claude (Minnie script + Rocky editing timeline) ===
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === xAI Grok (script + audio + video) ===
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROK_MODEL=grok-3

# Grok Video Generation (grok-imagine-video) — มีมนุษย์ + บรรยากาศจริง
# ถ้าไม่ตั้ง จะใช้ synthetic clips (FFmpeg gradient)
ROCKY_USE_GROK_VIDEO=1

# ใช้ xAI official SDK (pip install xai-sdk) แทน REST+urllib — ค่าเริ่มต้น = ปิด
# GROK_VIDEO_USE_XAI_SDK=1
# alias: GROK_VIDEO_USE_SDK=1
# ถ้า SDK error/timeout ให้ลอง REST ต่อ (ค่าเริ่มต้น = เปิด)
# GROK_VIDEO_SDK_FALLBACK_REST=1

# ใช้แพ็กเกจ xai-sdk (gRPC) แทน REST urllib สำหรับ generate วิดีโอ — ต้อง pip install xai-sdk
# 0 = REST เดิม (ค่าเริ่มต้น) | 1 = SDK
# GROK_VIDEO_USE_XAI_SDK=1
# เมื่อใช้ SDK แล้วล้มเหลว ให้ลอง REST ต่อหรือไม่ (ค่าเริ่มต้น = ลอง)
# GROK_VIDEO_SDK_FALLBACK_REST=1

# Rocky Final Render — ค่าเริ่มต้น = ต่อคลิปแบบรักษาคุณภาพ (concat + stream copy)
# ใส่ 1 เพื่อใช้เส้นทางเดิม (trim ultrafast + vignette + subtitle sample + encode หลายรอบ)
# ROCKY_EDITOR_LEGACY_FILTERS=1

# ดาวน์โหลดจาก CDN: บังคับ Authorization: Bearer {XAI_API_KEY} ทุกครั้ง (urllib เทียบเท่า requests.get + header)
# GROK_VIDEO_DOWNLOAD_USE_AUTH=0 ถูกละเว้น — CDN ยังใส่ Bearer อยู่ดี

# Poll หลัง POST /videos/generations — ให้สอดคล้าย xAI SDK (default ~10 นาที, ถามทุก ~5 วิ)
# GROK_VIDEO_POLL_MAX_SEC=600
# GROK_VIDEO_POLL_INTERVAL_SEC=5

# ความละเอียดวิดีโอ: 480p เร็วกว่า/ถูกกว่า, 720p ชัดกว่า (ตามเอกสาร xAI)
# GROK_VIDEO_RESOLUTION=720p

# เมื่อดาวน์โหลดล้มเหลวหรือได้ไฟล์เล็กกว่า GROK_VIDEO_MIN_BYTES — re-poll API เพื่อ signed URL ใหม่
# GROK_VIDEO_DOWNLOAD_RETRIES=5
# GROK_VIDEO_RETRY_DELAY_SEC=2

# ขนาดขั้นต่ำถึงจะยอมรับว่าเป็นวิดีโอจริง (ค่าเริ่มต้น 120000) — กันไฟล์ error/stub หลัก KB
# GROK_VIDEO_MIN_BYTES=120000

# Storyboard / API สตรีมฉาก — ขั้นต่ำเดียวกับ Grok (ค่าเริ่มต้น 100000)
# SCENE_VIDEO_MIN_BYTES=100000

# ตอนกด Regen — ลบ .mp4 จิ๋วใน output/clips/<project>/, grokVideo/, และ path ใน raw_clips (กัน error body ค้าง)
# GROK_JUNK_MAX_BYTES=65536

# ที่เก็บคลิปจาก Grok Video API — บันทึกไบต์จาก CDN ตรงๆ (ชื่อไฟล์ตาม path ของ URL เช่น uuid_hd.mp4)
# ค่าเริ่มต้น = grokVideo/ ใต้ aqond-brain (ให้ Rocky ชี้ path เดียวกับที่คุณเปิดจาก Imagine)
# GROK_VIDEO_DIR=grokVideo

# บังคับอัปโหลดรูปตัวละครในแท็บ Rocky ก่อนส่ง Gen (ค่าเริ่มต้น = ไม่บังคับ — Rocky คิดฉากเองได้)
# ROCKY_REQUIRE_CHARACTER_REF=1

# ย่อรูป ref ก่อนส่ง Grok (ขอบยาวสุด pixel)
# GROK_REF_IMAGE_MAX_EDGE=1280

# Grok TTS (Thai voiceover) — มี 5 voices: eve, ara, rex, sal, leo
# ถ้าไม่ตั้ง จะไม่มีเสียงพากย์
GROK_TTS_VOICE=ara

# === Flow 3 — Story Cinema (Grok Video + TTS, มาตรฐาน grokVideo/) ===
# FLOW3_USE_GROK=1
# FLOW3_ACT_COUNT=6
# FLOW3_CLIP_DURATION=12
# FLOW3_CREATIVITY=medium
# FLOW3_SUBTITLES=1
# FLOW3_PREVIEW_GROK_DURATION=8

# === Flow 3 preview (Phase 3) ===
# POST /api/flow2/preview → status preview_ready → POST /api/flow2/generate { continue_job_id }
# POST /api/flow3/preview → POST /api/flow3/generate { continue_job_id }

# === Discord Bot (Dashboard with Approve/Reject buttons) ===
DISCORD_BOT_TOKEN=MTQ4MzgyNDU1NzIxMDIxMDUwNQ.GHkAYa.xxxxxxxxxxxxxxxxxxxxxxxxxx
FACTORY_PREVIEW_CHANNEL_ID=1234567890123456789

# === Video Generation APIs (optional — MVP uses FFmpeg synthetic) ===
# Runway Gen-3 (ต้อง credits)
# RUNWAY_API_KEY=xxxxx

# Synthesia (AI Avatar, ต้อง subscription)
# SYNTHESIA_API_KEY=xxxxx

# === Social Media Publishing (Thomas) ===
# Facebook Graph API (Thomas — multipart upload ไป graph-video.facebook.com)
# FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# FB_PAGE_ID=123456789012345
# FB_GRAPH_VERSION=v21.0

# TikTok Content Posting API
# TIKTOK_ACCESS_TOKEN=act.xxxxxxxxxxxxxxx

# Auto-Post / Social Sync — Thomas ส่ง JSON batch (วิดีโอ path + caption + hashtags) ไป webhook
# SOCIAL_SYNC_WEBHOOK_URL=https://your-autopost.example.com/hook

# Instagram Graph API (Business/Creator account)
# IG_ACCESS_TOKEN=IGxxxxxxxxxxxxxxxxxx
# IG_USER_ID=17841400000000000

# === ElevenLabs Voice (AI voiceover) ===
# ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Hook Factory (media_factory_orchestrator) ===
# AQOND Voice Studio TTS — local or ngrok tunnel from app_voice_api.py
# AQOND_TTS_URL=http://127.0.0.1:8000/api/v1/generate-voice
# HOOK_DEFAULT_CHARACTER=man
# HOOK_MAX_OUTPUT_MB=15
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=   (DALL-E 3 hook images — optional, falls back to Grok/stock)

# === Media Studio (3 Flows + Qwen Vision) — port 8780 ===
# MEDIA_STUDIO_PORT=8780
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Flow 1 image — OpenAI (ใช้ gpt-image-1 ถ้า dall-e-3 ไม่รองรับใน key ของคุณ)
# FLOW1_IMAGE_MODEL=gpt-image-1
# FLOW1_USE_UPLOAD_AS_IMAGE=0

# QWEN_VISION_MODEL=qwen2.5vl:3b
# ติดตั้ง: ollama pull qwen2.5vl:3b   (GT 1030 ใช้ 3b; ถ้า RAM/GPU พอใช้ 7b)

# === Local image generation (free — Ollama + optional SD WebUI) ===
# IMAGE_PROVIDER=local_first
# local_first = Ollama/A1111 ก่อน → OpenAI ถ้าล้มเหลว | local_only = ไม่เรียก OpenAI | openai_first = เดิม
# LOCAL_IMAGE_BACKEND=ollama,a1111
# LOCAL_IMAGE_MODEL=x/z-image-turbo
# LOCAL_IMAGE_WIDTH=768
# LOCAL_IMAGE_HEIGHT=1344
# LOCAL_IMAGE_WIDTH_FLOW1=1024
# LOCAL_IMAGE_HEIGHT_FLOW1=1024
# LOCAL_IMAGE_STEPS=20
# SD_WEBUI_URL=http://127.0.0.1:7860
# SD_WEBUI_MODEL=
# SD_WEBUI_QUALITY=high
# SD_WEBUI_SAMPLER=DPM++ 2M Karras
# SD_WEBUI_CFG=7.5
# SD_WEBUI_CLIP_SKIP=2
# SD_WEBUI_HIRES=0
# SD_WEBUI_MODEL=realisticVisionV51_v51VAE.safetensors
# LOCAL_IMAGE_STEPS=28
# ติดตั้ง Ollama image: ollama pull x/z-image-turbo
# ทางเลือก A1111/Forge: เปิดด้วย --api บนพอร์ต 7860
